  "papyrus.info.feedback.info": "Thank you for taking a few minutes to share your feedback about the Papyrus institutional repository.",
  "papyrus.info.alert.message": "<span class=\"tme\">\n  <i class=\"fa fa-info-circle\" aria-hidden=\"true\"></i>\n  <strong>Mandatory Submission of Theses and Dissertations</strong>:<br>\n  For any information or support regarding the electronic submission of theses and dissertations, please refer to the website \n  <a href=\"http://www.bib.umontreal.ca/theses\" target=\"_blank\">UdeM Theses and Dissertations</a> and especially its section \n  <a href=\"http://www.bib.umontreal.ca/theses/aide.htm\" target=\"_blank\">Need Help</a>.\n</span>",
